[32m+[m[32mdocker compose build --pull[m
[32m+[m[32mdocker compose up -d --wait[m
[32m+[m[32m.\deploy\smoke-test.ps1[m
[32m+[m[32m.\deploy\security-test.ps1[m
[32m+[m[32m```[m
